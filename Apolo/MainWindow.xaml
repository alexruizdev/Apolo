<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Apolo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Apolo"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:Microsoft.UI.Xaml.Controls"
        xmlns:loc="using:Apolo.Services"
        Title="{x:Bind loc:Loc.Common_AppTitle}"
        Activated="Window_Activated"
        mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  NavigationView  -->
        </Grid.RowDefinitions>

        <TitleBar Title="{x:Bind loc:Loc.Common_AppTitle}"
                  Subtitle="{x:Bind loc:Loc.Common_InvoiceManager}"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False">

        </TitleBar>

        <ui:NavigationView x:Name="NavView"
                           Grid.Row="1"
                           IsSettingsVisible="False"
                           IsPaneToggleButtonVisible="True"
                           PaneDisplayMode="Top"
                           SelectionChanged="NavView_SelectionChanged">

            <ui:NavigationView.MenuItems>
                <!--Lesson-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Lessons}"
                                       Icon="Calendar"
                                       Tag="lessons" />
                <!--Invoicing-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Invoicing}"
                                       Icon="Tag"
                                       Tag="invoicing" />
                <!--Payers-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Payers}"
                                       Icon="ContactInfo"
                                       Tag="payers" />
                <!--Students-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Students}"
                                       Icon="Contact"
                                       Tag="students" />
                <!--Service-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Services}"
                                       Tag="services">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE821;" />
                    </NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!--Specifications-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Specifications}"
                                       Icon="Favorite"
                                       Tag="specifications" />
                <!--Dashboard-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Dashboard}"
                                       Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!--Proposal-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Proposal}"
                                       Tag="proposal">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!--Settings-->
                <ui:NavigationViewItem Content="{x:Bind loc:Loc.Menu_Settings}"
                                       Icon="Setting"
                                       Tag="settings" />
            </ui:NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status / errors -->
                <StackPanel Grid.Row="0"
                            Spacing="4"
                            Margin="24,10,24,0">
                    <ProgressBar IsIndeterminate="{x:Bind CurrentViewModel.IsBusy, Mode=OneWay}"
                                 Visibility="{x:Bind GetProgressBarVisibility(CurrentViewModel.IsBusy), Mode=OneWay}" />
                    <InfoBar x:Name="AppInfoBar"
                             IsOpen="{x:Bind CurrentViewModel.OpenInfoBar, Mode=TwoWay}"
                             Severity="{x:Bind GetInfoBarSeverity(CurrentViewModel.InfoBarType), Mode=OneWay}"
                             Message="{x:Bind CurrentViewModel.InfoMessage, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind CurrentViewModel.ActionButtonText, Mode=OneWay}"
                                    Command="{x:Bind CurrentViewModel.ActionButtonCommand, Mode=OneWay}"
                                    Visibility="{x:Bind GetActionButtonVisibility(CurrentViewModel.ActionButtonText), Mode=OneWay}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <Frame x:Name="RootFrame"
                       Grid.Row="1" />
            </Grid>
        </ui:NavigationView>

    </Grid>
</Window>
